---
import Logo from './Logo.astro';
import { NAV_ITEMS, links, withBase } from '../lib/site';

interface Props {
  /** Home page renders anchor links; other pages link back to home sections. */
  home?: boolean;
}
const { home = true } = Astro.props;
const hrefFor = (anchor: string): string => (home ? anchor : withBase('') + anchor);
---

<nav class="nav" aria-label="Main">
  <div class="container nav-inner">
    <a class="nav-logo" href={withBase('')} aria-label="ArNega home">
      <Logo size={26} />
      ArNega
    </a>
    <div class="nav-links">
      {NAV_ITEMS.map((item) => (
        <a class="link-quiet" href={hrefFor(item.href)}>{item.label}</a>
      ))}
    </div>
    <div class="nav-spacer"></div>
    <div class="nav-actions">
      <a
        class="nav-github"
        href={links.source}
        target="_blank"
        rel="noopener"
        aria-label="ArNega on GitHub"
        title="View source on GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a class="btn btn-primary btn-small" href={links.primaryDmg}>Download</a>
      <button class="nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M2 4.5h12M2 8h12M2 11.5h12"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="container nav-mobile" id="nav-mobile" data-open="false">
    {NAV_ITEMS.map((item) => <a href={hrefFor(item.href)}>{item.label}</a>)}
    <a href={links.source} target="_blank" rel="noopener">GitHub</a>
  </div>
</nav>

<script>
  const burger = document.querySelector('.nav-burger');
  const mobile = document.getElementById('nav-mobile');
  if (burger && mobile) {
    burger.addEventListener('click', () => {
      const open = mobile.getAttribute('data-open') === 'true';
      mobile.setAttribute('data-open', String(!open));
      burger.setAttribute('aria-expanded', String(!open));
    });
    mobile.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        mobile.setAttribute('data-open', 'false');
        burger.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
