{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "paths": {
      "@arnega/shared": ["../../packages/shared/src/index.ts"],
      "@arnega/branding": ["../../packages/branding/src/index.ts"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "test/**/*.ts"
  ]
}
